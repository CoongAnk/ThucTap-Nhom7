# Copy this file to .env and fill in real values. NEVER commit the real .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
PORT=5000

# Use a long, random, high-entropy value (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# bcrypt cost factor
SALT_ROUNDS=10

# OpenRouter API key used by the AI tutor service
OPENROUTER_API_KEY=your_openrouter_api_key_here
